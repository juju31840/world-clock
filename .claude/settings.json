{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_console_log.py\"",
            "timeout": 15,
            "statusMessage": "Recherche de console.log() dans les fichiers .js stagés..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_basic_syntax.py\"",
            "timeout": 15,
            "statusMessage": "Vérification basique de syntaxe..."
          }
        ]
      }
    ]
  }
}
